# ============================================================
# .env.example — copy this file to .env and fill in real values
# .env is listed in .gitignore and must NEVER be committed
# ============================================================

# ── User Credentials ─────────────────────────────────────────
# Option A (recommended): supply a pre-computed PBKDF2-HMAC-SHA256 hash.
#   Generate with: python -c "from auth_config import hash_password; print(hash_password('yourpassword'))"
#   Hash format:   pbkdf2_sha256$100000$<salt_hex>$<hash_hex>
#   PHARMACIST1_PASSWORD_HASH=<pbkdf2_sha256$...> value
#
#   Legacy unsalted SHA-256 hashes (64-char hex) are still accepted and
#   will be transparently upgraded to PBKDF2 in memory on first login.
#
# Option B: supply the plaintext password — it is hashed at runtime via
#   PBKDF2-HMAC-SHA256 with a random 128-bit salt.
#   The plaintext is never stored on disk.
PHARMACIST1_PASSWORD=your_pharmacist1_password
PHARMACIST2_PASSWORD=your_pharmacist2_password
ADMIN_PASSWORD=your_admin_password


# ── Email Alert Settings (Gmail SMTP) ────────────────────────
# Create a Gmail App Password (not your account password):
#   https://myaccount.google.com/apppasswords
EMAIL_SENDER=yourpharmacy@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_RECEIVER=pharmacist@pharmacy.com

# ── Application URL ──────────────────────────────────────────
# Used in email alert links. Change to your deployment address.
APP_URL=http://localhost:8501
