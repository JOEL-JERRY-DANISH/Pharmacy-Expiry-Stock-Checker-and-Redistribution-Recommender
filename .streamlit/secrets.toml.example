# ============================================================
# .streamlit/secrets.toml.example
#
# Copy this file to .streamlit/secrets.toml and fill in your
# own values.  secrets.toml is listed in .gitignore and must
# NEVER be committed to version control.
#
# Passwords are stored as SHA-256 hex digests so that no
# plaintext password ever appears in a config file.
#
# Generate a hash on the command line:
#   Python:  python -c "import hashlib; print(hashlib.sha256('yourpassword'.encode()).hexdigest())"
#   Linux:   echo -n 'yourpassword' | sha256sum
# ============================================================

[auth]
# SHA-256 hashes of each user's password (no plaintext here)
pharmacist1_password_hash = "replace_with_sha256_hash_of_pharmacist1_password"
pharmacist2_password_hash = "replace_with_sha256_hash_of_pharmacist2_password"
admin_password_hash       = "replace_with_sha256_hash_of_admin_password"

[email]
# Gmail SMTP credentials (optional - email alerts are skipped if blank)
sender   = "yourpharmacy@gmail.com"
password = "your_16_char_app_password"
receiver = "pharmacist@pharmacy.com"
