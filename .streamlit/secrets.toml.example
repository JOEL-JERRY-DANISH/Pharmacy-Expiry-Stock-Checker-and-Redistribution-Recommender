# ============================================================
# .streamlit/secrets.toml.example
#
# Copy this file to .streamlit/secrets.toml and fill in your
# own values.  secrets.toml is listed in .gitignore and must
# NEVER be committed to version control.
#
# Passwords are stored as PBKDF2-HMAC-SHA256 hashes so that no
# plaintext password ever appears in a config file.
#
# Hash format:  pbkdf2_sha256$<iterations>$<salt_hex>$<hash_hex>
#
# Generate a hash using the project's own utility:
#   python -c "from auth_config import hash_password; print(hash_password('yourpassword'))"
#
# Legacy unsalted SHA-256 hashes (64-char hex) are still accepted for
# backwards compatibility and will be upgraded in memory to PBKDF2 on
# first successful login.  Regenerate them with the command above to
# adopt the current secure format.
# ============================================================

[auth]
# PBKDF2-HMAC-SHA256 hashes of each user's password (no plaintext here)
# Format: pbkdf2_sha256$100000$<salt_hex>$<hash_hex>
pharmacist1_password_hash = "replace_with_pbkdf2_hash_of_pharmacist1_password"
pharmacist2_password_hash = "replace_with_pbkdf2_hash_of_pharmacist2_password"
admin_password_hash       = "replace_with_pbkdf2_hash_of_admin_password"


[email]
# Gmail SMTP credentials (optional - email alerts are skipped if blank)
sender   = "yourpharmacy@gmail.com"
password = "your_16_char_app_password"
receiver = "pharmacist@pharmacy.com"
